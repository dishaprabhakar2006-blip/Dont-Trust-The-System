APP_NAME=Don't Trust the System API
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
GAME_DURATION_SECONDS=1800
# Comma-separated browser origins; set the frontend's actual origin(s).
FRONTEND_ORIGINS=
# Leave FIREBASE_DATABASE_URL empty to use the local in-memory repository.
FIREBASE_DATABASE_URL=
# Optional service-account JSON path. Otherwise ADC / GOOGLE_APPLICATION_CREDENTIALS is used.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional, for local Firebase Emulator Suite development only.
FIREBASE_DATABASE_EMULATOR_HOST=
